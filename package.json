{
  "name": "n8n-nodes-allowly",
  "version": "0.1.1",
  "description": "n8n community node for creating Allowly authorizations and checking agent actions",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "allowly",
    "authorization",
    "ai-agent",
    "receipts"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://allowly.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allowly-AI/n8n-nodes-allowly.git"
  },
  "author": {
    "name": "Allowly LLC",
    "email": "support@allowly.ai"
  },
  "main": "dist/nodes/Allowly/Allowly.node.js",
  "types": "dist/nodes/Allowly/Allowly.node.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run build --silent && node --test test/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "release": "n8n-node release",
    "scan": "scan-community-package n8n-nodes-allowly"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/AllowlyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Allowly/Allowly.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "^0.9.0",
    "@n8n/node-cli": "^0.34.0",
    "@n8n/scan-community-package": "^0.20.0",
    "@types/node": "^20.14.10",
    "n8n-workflow": "^1.82.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
