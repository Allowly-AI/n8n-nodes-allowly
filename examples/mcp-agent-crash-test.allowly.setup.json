{
  "actions": [
    {
      "name": "mcp_demo.email.send",
      "description": "Send the requested email after Allowly has checked trusted local context."
    }
  ],
  "policies": [
    {
      "profile": "allowly.policy.v1",
      "policy_id": "mcp_agent_crash_test_v1",
      "agent_id": "n8n_mcp_agent",
      "description": "Deny customer exports and confirm other external sends.",
      "default_expiry_days": 30,
      "actions": [
        {
          "policy": {
            "profile": "allowly.basic.v1",
            "action": "mcp_demo.email.send",
            "default_decision": "allow",
            "default_target": null,
            "fields": {
              "recipient_scope": "string",
              "recipient_count": "integer",
              "data_class": "string"
            },
            "rules": [
              {
                "id": "deny-customer-export",
                "decision": "deny",
                "target": null,
                "conditions": [
                  {
                    "field": "data_class",
                    "op": "eq",
                    "value": "customer_export"
                  }
                ]
              },
              {
                "id": "confirm-external-recipient",
                "decision": "confirm",
                "target": "agent_owner",
                "conditions": [
                  {
                    "field": "recipient_scope",
                    "op": "eq",
                    "value": "external"
                  }
                ]
              }
            ]
          },
          "guards": {
            "max_per_day": 5
          },
          "executable_operations": []
        }
      ]
    }
  ]
}
