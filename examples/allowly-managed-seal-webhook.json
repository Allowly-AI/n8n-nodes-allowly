    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "managed-seal-record-id",
              "name": "record_id",
              "value": "invoice_webhook_demo_001",
              "type": "string"
            },
            {
              "id": "managed-seal-record-json",
              "name": "record_json",
              "value": "{\"amount\":125.5,\"currency\":\"USD\",\"customer\":\"buyer@example.invalid\",\"invoice_id\":\"invoice_webhook_demo_001\",\"lines\":[{\"quantity\":2,\"sku\":\"demo-1\"}]}",
              "type": "string"
            },
            {
              "id": "managed-seal-type",
              "name": "receipt_type",
              "value": "invoice",
              "type": "string"
            },
            {
              "id": "managed-seal-reference",
              "name": "receipt_reference",
              "value": "INV-1042",
              "type": "string"
