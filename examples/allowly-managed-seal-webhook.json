      "id": "49e264ff-e097-5faf-b182-7eb26a29646f",
      "name": "1. JSON RECORD - Map Yours Here",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "operation": "sealWebhook",
        "sealRecordInputMode": "rawJson",
        "sealRecordJson": "={{ $json.record_json }}",
        "sealWebhookType": "={{ $json.receipt_type }}",
        "sealWebhookReference": "={{ $json.receipt_reference }}",
        "sealWebhookStatement": "={{ $json.receipt_statement }}",
        "sealWebhookIdempotencyKey": "={{ 'n8n-managed-seal:' + $execution.id + ':' + $json.record_id }}",
        "sealWebhookWaitSeconds": 120
      },
      "id": "db9c9063-4985-55bf-84a9-b9a4d8a29989",
      "name": "2. SEAL + WAIT + VERIFY",
