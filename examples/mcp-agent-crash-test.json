    {
      "parameters": {
        "jsCode": "const payload = $json.payload;\nif (!payload || typeof payload !== 'object') throw new Error('send_email payload must be an object.');\nconst to = String(payload.to || '').trim();\nconst subject = String(payload.subject || '').trim();\nconst body = String(payload.body || '');\nconst recipients = to.split(/[;,]/).map((value) => value.trim().toLowerCase()).filter(Boolean);\nconst emailPattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (recipients.length === 0 || recipients.some((value) => !emailPattern.test(value))) throw new Error('A valid recipient is required.');\nif (recipients.length > 25) throw new Error('At most 25 recipients are allowed.');\nif (!subject) throw new Error('A subject is required.');\nconst recipientDomains = recipients.map((value) => value.split('@').pop());\nconst recipientScope = recipientDomains.every((domain) => domain === 'company.example') ? 'internal' : 'external';\nconst bodyEmails = body.toLowerCase().match(/[a-z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-z0-9-]+(?:\\.[a-z0-9-]+)+/g) || [];\nconst customerEmails = [...new Set(bodyEmails.filter((value) => value.endsWith('@example.invalid')))];\nconst dataClass = customerEmails.length >= 2 ? 'customer_export' : 'normal';\nconst allowlyContext = { recipient_scope: recipientScope, recipient_count: recipients.length, data_class: dataClass };\nreturn [{ json: { ...$json, to, subject, body, allowly_context: allowlyContext } }];"
      },
      "id": "09554d88-ff8b-4164-a8b2-7484fed081dd",
      "name": "Derive trusted context locally",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
