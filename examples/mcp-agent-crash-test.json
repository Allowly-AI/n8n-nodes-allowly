      "parameters": {
        "operation": "check",
        "authorization": "={{ $json.authorization_id }}",
        "actions": "mcp_demo.email.send",
        "resource": "={{ 'zoho-mail:outbound:' + $json.allowly_context.recipient_scope }}",
        "session": "={{ 'n8n-mcp-crash-test:' + $execution.id }}",
        "workflowAgent": "n8n_mcp_agent",
        "contextJson": "={{ JSON.stringify($json.allowly_context) }}"
      },
      "id": "24df74d0-c3ca-4743-b7a2-298e24d31e7b",
      "name": "Allowly checks before Zoho Mail",
      "type": "n8n-nodes-allowly.allowly",
      "typeVersion": 2,
      "position": [
        880,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "const decision = $json;\nconst action = 'mcp_demo.email.send';\nconst receiptId = decision.receipt?.receipt_id ?? decision.receipt?.receipt?.receipt_id;\nif (decision.action !== action || !['allow', 'deny', 'confirm', 'escalate'].includes(decision.decision) || decision.results?.[action]?.decision !== decision.decision || typeof decision.reason !== 'string' || !decision.reason || typeof receiptId !== 'string' || !/^rcp_[A-Za-z0-9_-]+$/.test(receiptId)) {\n  throw new Error('Invalid Allowly decision; Zoho Mail was not called.');\n}\nreturn [{ json: { ...decision, receipt_id: receiptId } }];"
      },
      "id": "5a4dde16-f19e-4ac2-a654-70f15703fd42",
      "name": "Validate Allowly decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        460
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "explicit-allow-only",
              "leftValue": "={{ $json.decision }}",
              "rightValue": "allow",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "bfc41d6a-45c3-46e7-8e4f-5be10c54fd58",
      "name": "Allowly decision is allow",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1360,
        460
      ]
    },
